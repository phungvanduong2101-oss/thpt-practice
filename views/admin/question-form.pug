extends layouts/default.pug

block styles
  link(
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
  )
  link(
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css"
  )
  link(rel="stylesheet" href="/admin/css/questions.css")
  link(rel="stylesheet" href="/admin/css/question-latex.css")

block content
  - const bloomLabels = ["", "Nhớ", "Hiểu", "Vận dụng", "Phân tích", "Đánh giá", "Sáng tạo"];

  #questionPageData(
    hidden
    data-bootstrap=JSON.stringify({ subjects, topics, questions: question ? [question] : [] })
  )

  .question-main
    .page-heading.question-heading
      div
        .eyebrow BIÊN TẬP NỘI DUNG
        h1= question ? "Chỉnh sửa câu hỏi" : "Soạn câu hỏi mới"
        p Soạn nội dung, đáp án và lời giải.

      a.button.button--secondary(href="/admin/questions")
        | Quay lại danh sách

    .questions-layout.questions-layout--form.questions-layout--latex
      section#editorPanel.panel.question-editor-panel(
        aria-labelledby="formTitle"
      )
        .panel-header.question-editor-header
          div
            .form-panel__eyebrow BIÊN TẬP NỘI DUNG
            h2#formTitle= question ? "Chỉnh sửa câu hỏi" : "Tạo câu hỏi mới"

            p
              | Hỗ trợ công thức LaTeX tại nút 
              b ƒx
              |  trên thanh công cụ.

          span.form-header-icon
            svg.icon
              use(href="#i-edit")

        #editorOfflineNote.editor-offline-note(hidden)
          | Không tải được Quill/KaTeX. Trình soạn thảo đang dùng chế độ văn bản dự phòng.

        form#questionForm(novalidate)
          .editor-section-title
            span 01
            |  Phân loại câu hỏi

          .question-field-grid
            .field
              label(for="questionSubject")
                | Môn học 
                em *

              select#questionSubject(name="subjectId" required)
                option(value="") Chọn môn học

                each subject in subjects
                  option(value=subject._id)
                    = subject.name + (subject.active ? "" : " (Đã ẩn)")

            .field
              label(for="questionTopic")
                | Chuyên đề 
                em *

              select#questionTopic(
                name="topicId"
                required
                disabled
              )
                option(value="") Chọn chuyên đề

            .field
              label(for="questionType")
                | Loại câu hỏi 
                em *

              select#questionType(name="type")
                option(value="mcq") Trắc nghiệm ABCD
                option(value="truefalse") Đúng / Sai (4 mệnh đề)
                option(value="fill") Điền đáp số

            .field
              label(for="questionBloom")
                | Mức độ Bloom 
                em *

              select#questionBloom(name="bloomLevel")
                each bloomLabel, level in bloomLabels
                  if level > 0
                    option(
                      value=level
                      selected=level === 3
                    )= level + " · " + bloomLabel

          .field
            label(for="questionStatus") Trạng thái

            select#questionStatus(name="status")
              option(value="published") Đã xuất bản
              option(value="draft") Bản nháp

          .editor-section-title
            span 02
            |  Nội dung câu hỏi 
            em *

          #questionContent.rich-editor.rich-editor--main(
            aria-label="Soạn nội dung câu hỏi"
          )

          small.question-hint
            | Tra cứu và chỉnh công thức ở khung bên phải, sau đó copy mã vào nút 
            b ƒx
            |  để chèn.

          .editor-section-title
            span 03
            |  Phương án trả lời và đáp án

          #mcqAnswers.answer-section
            .answer-section__intro
              | Soạn 4 lựa chọn, sau đó đánh dấu 
              b một đáp án đúng
              | .

            #mcqOptions.option-editors

          #tfAnswers.answer-section(hidden)
            .answer-section__intro
              | Nhập bốn mệnh đề a, b, c, d. Chọn 
              b Đúng hoặc Sai riêng cho từng ý
              | .

            #tfOptions.option-editors

          #fillAnswers.answer-section(hidden)
            .field
              label(for="fillCorrectAnswer")
                | Đáp án đúng 
                em *

              input#fillCorrectAnswer(
                type="text"
                placeholder="Ví dụ: 2.5"
                autocomplete="off"
              )

              small.field-hint
                | Nhiều đáp án hợp lệ ngăn cách bằng dấu |. Ví dụ: 0.5 | 1/2

          .editor-section-title
            span 04
            |  Lời giải / giải thích 
            small (không bắt buộc)

          #questionExplanation.rich-editor.rich-editor--explanation(
            aria-label="Soạn lời giải"
          )

          #formError.question-form-error(role="alert" hidden)

          .question-form-actions
            button#resetButton.button.button--secondary(type="button")
              | Làm mới

            button#previewButton.button.button--secondary(type="button")
              svg.icon
                use(href="#i-search")
              |  Xem trước

            button#saveButton.button.button--primary(type="submit")
              svg.icon
                use(href="#i-save")
              span#saveButtonText Lưu câu hỏi

      aside.latex-sidebar(aria-label="Tra cứu và soạn công thức")
        section.panel.latex-library
          .latex-panel-heading
            div
              span.latex-eyebrow THƯ VIỆN LATEX
              h2 Công thức mẫu

            span#latexCount.latex-count

          label.latex-label(for="latexSearch") Tìm công thức

          input#latexSearch.latex-input(
            type="search"
            placeholder="Tìm tên hoặc mã LaTeX..."
            autocomplete="off"
          )

          label.latex-label.latex-select-label(for="latexCode")
            | Chọn công thức

          select#latexCode.latex-input
            option(value="") — Chọn công thức mẫu —
            each formula in formulas
              option(value=formula.code)= formula.name

          p#latexEmpty.latex-hint(hidden)
            | Không tìm thấy công thức phù hợp.

          .latex-preview-heading
            strong Xem trước mẫu

          #latexTemplatePreview.latex-preview.latex-preview--template
            | Chọn một mẫu để xem công thức.

          label.latex-label.latex-select-label(for="latexTemplateCode")
            | Mã mẫu

          textarea#latexTemplateCode.latex-source.latex-source--template(
            rows="2"
            readonly
            spellcheck="false"
            placeholder="Mã LaTeX của mẫu..."
          )

          .latex-library-actions
            button#copyTemplate.button.button--secondary(
              type="button"
              disabled
            ) Copy mẫu

            button#addTemplate.button.button--primary(
              type="button"
              disabled
            ) Thêm vào ô soạn

          p.latex-hint
            | Mẫu được thêm tại vị trí con trỏ hoặc thay thế đoạn đang bôi đen trong ô soạn.

        section.panel.latex-composer
          .latex-panel-heading
            div
              span.latex-eyebrow KHÔNG GIAN SOẠN THỬ
              h2 Soạn công thức

            button#clearLatex.latex-text-button(type="button")
              | Xóa mã

          label.latex-label(for="latexSource") Mã LaTeX

          textarea#latexSource.latex-source(
            rows="5"
            spellcheck="false"
            placeholder="Dán hoặc thêm các mẫu công thức tại đây..."
          )

          p.latex-hint
            | Ghép các mẫu, sửa biến và thêm phép tính để tạo công thức.

          .latex-preview-heading
            strong Xem trước
            span Cập nhật trực tiếp

          #latexPreview.latex-preview(aria-live="polite")
            | Công thức sẽ hiển thị ở đây.

          p#latexError.latex-error(role="status" hidden)

          button#copyLatex.button.button--primary.latex-copy-button(
            type="button"
          ) Copy LaTeX đã chỉnh sửa

          p.latex-hint
            | Copy mã → bấm ƒx tại nội dung, đáp án hoặc lời giải → dán mã.

        p#latexStatus.latex-status(
          role="status"
          aria-live="polite"
        )

  #previewModal.modal-overlay.question-modal(hidden)
    section.dialog.question-dialog(
      role="dialog"
      aria-modal="true"
      aria-labelledby="previewTitle"
    )
      .question-modal-heading
        div
          span XEM TRƯỚC CÂU HỎI VÀ ĐÁP ÁN
          h2#previewTitle Nội dung câu hỏi

        button#closePreview.question-icon-button(
          type="button"
          aria-label="Đóng xem trước"
        )
          svg.icon
            use(href="#i-x")

      #previewBody.preview-body

      .dialog__actions
        button#donePreview.button.button--primary(type="button")
          | Đóng xem trước

  #toast.toast(role="status" aria-live="polite")

block scripts
  script(
    defer
    src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"
  )
  script(
    defer
    src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"
  )
  script(src="/admin/js/question-form.js" defer)
  script(src="/admin/js/question-latex.js" defer)