extends layouts/default.pug

block styles
  link(rel="stylesheet" href="/admin/css/dashboard-polish.css")

block content
  mixin dashboardIcon(name)
    svg.icon(aria-hidden="true")
      use(href="#" + name)

  mixin statCard(label, value, note, icon, color)
    .stat-card
      span.stat-card__icon(class="stat-card__icon--" + color)
        +dashboardIcon(icon)
      div
        span.stat-card__label= label
        strong= Number(value || 0).toLocaleString("vi-VN")
        span.stat-card__note= note

  mixin quickAction(href, title, description, icon, color)
    a.dashboard-action(href=href)
      span.stat-card__icon(class="stat-card__icon--" + color)
        +dashboardIcon(icon)
      div
        strong= title
        small= description

  .page-heading.dashboard-heading
    div
      .eyebrow
        +dashboardIcon("i-grid")
        |  QUẢN TRỊ HỆ THỐNG
      h1 Tổng quan hệ thống
      p Theo dõi dữ liệu và quản lý nội dung ôn luyện THPT.

    a.button.button--primary.page-heading__action(href="/admin/questions")
      +dashboardIcon("i-plus")
      |  Quản lý câu hỏi

  section.stats-grid.dashboard-stats(aria-label="Thống kê hệ thống")
    +statCard(
      "Người dùng",
      totalAccounts,
      "Tài khoản trong hệ thống",
      "i-users",
      "blue"
    )
    +statCard(
      "Môn học",
      totalSubjects,
      "Danh mục môn học",
      "i-book",
      "green"
    )
    +statCard(
      "Câu hỏi",
      totalQuestions,
      "Ngân hàng câu hỏi",
      "i-help",
      "violet"
    )
    +statCard(
      "Đề thi",
      totalExams,
      "Đề thi trong hệ thống",
      "i-clipboard",
      "blue"
    )

  section.panel.dashboard-panel
    .panel-header
      div
        h2 Thao tác nhanh
        p Truy cập các chức năng quản lý nội dung.

    .dashboard-actions
      +quickAction(
        "/admin/subjects",
        "Môn học",
        "Quản lý danh mục môn học",
        "i-book",
        "blue"
      )
      +quickAction(
        "/admin/topics",
        "Chuyên đề",
        "Phân chia nội dung theo môn",
        "i-layers",
        "violet"
      )
      +quickAction(
        "/admin/questions",
        "Ngân hàng câu hỏi",
        "Soạn thảo và cập nhật câu hỏi",
        "i-help",
        "green"
      )
      +quickAction(
        "/admin/exams",
        "Quản lý đề thi",
        "Tạo đề và lựa chọn câu hỏi",
        "i-clipboard",
        "blue"
      )


  .dashboard-columns
    div
      section.panel.dashboard-panel
        .panel-header
          div
            h2 Câu hỏi mới nhất
            p Các câu hỏi được thêm gần đây.
          a.dashboard-link(href="/admin/questions") Xem tất cả

        if newestQuestion.length
          .table-scroll
            table.dashboard-table
              thead
                tr
                  th CÂU HỎI
                  th TRẠNG THÁI
              tbody
                each question in newestQuestion
                  tr
                    td
                      a.dashboard-table__title(href="/admin/questions")
                        = question.contentText || "Câu hỏi chưa có tiêu đề"
                      span.dashboard-table__sub
                        if question.type === "mcq"
                          | Trắc nghiệm
                        else if question.type === "truefalse"
                          | Đúng / Sai
                        else if question.type === "fill"
                          | Điền đáp số
                        else
                          | Chưa phân loại
                    td
                      span.dashboard-badge(
                        class=question.published ? "dashboard-badge--success" : ""
                      )= question.published ? "Đã xuất bản" : "Bản nháp"
        else
          .dashboard-empty Chưa có câu hỏi nào trong danh sách.

    div
      section.panel.dashboard-panel
        .panel-header
          div
            h2 Đề thi mới nhất
            p Các đề thi được tạo gần đây.
          a.dashboard-link(href="/admin/exams") Xem tất cả

        if newestExam.length
          .table-scroll
            table.dashboard-table
              thead
                tr
                  th ĐỀ THI
                  th SỐ CÂU
              tbody
                each exam in newestExam
                  tr
                    td
                      a.dashboard-table__title(href="/admin/exams")
                        = exam.title || "Đề thi chưa có tiêu đề"
                      span.dashboard-table__sub= (exam.subjectId && exam.subjectId.name) || "Chưa có môn học"
                    td= exam.questionIds.length || 0
        else
          .dashboard-empty Chưa có đề thi nào trong danh sách.

      section.panel.dashboard-panel
        .panel-header
          div
            h2 Xây dựng nội dung
            p Các bước chuẩn bị ngân hàng đề.

        ol.dashboard-guide
          li
            div
              strong Tạo môn học
              p Khởi tạo các môn học được hỗ trợ trong hệ thống.
          li
            div
              strong Thêm chuyên đề
              p Phân chia kiến thức theo từng môn học.
          li
            div
              strong Soạn câu hỏi
              p Thêm câu hỏi trắc nghiệm, đúng sai và điền đáp số.
          li
            div
              strong Tạo đề thi
              p Lựa chọn câu hỏi cùng môn để xây dựng đề thi.