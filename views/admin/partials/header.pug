header.admin-header
  .admin-header__left
    button#menuButton.icon-btn.mobile-menu-button(
      type="button"
      aria-label="Mở menu quản trị"
      aria-controls="sidebar"
      aria-expanded="false"
    )
      svg.icon(aria-hidden="true")
        use(href="#i-menu")

    .breadcrumb
      span Quản trị
      svg.icon(aria-hidden="true")
        use(href="#i-chevron")
      b= typeof title !== "undefined" ? title : "Tổng quan"

  .admin-header__actions
    .action-wrap.notification-wrap
      button#notificationButton.icon-button.notification-button(
        type="button"
        aria-expanded="false"
        aria-controls="notificationPanel"
        aria-label="Thông báo"
      )
        i(data-lucide="bell" aria-hidden="true")

        span#notificationCount.notification-count(hidden)
          | 0

      #notificationPanel.utility-popover.notification-panel(hidden)
        .notification-panel-heading
          strong Thông báo

          span#notificationConnection.notification-connection(
            role="status"
          ) Đang kết nối...

        p#notificationError.notification-error(
          role="alert"
          hidden
        )

        #notificationList.notification-list
          p.notification-empty Đang tải thông báo...

    .admin-profile
      span.admin-avatar= currentAccount.fullName.charAt(0).toUpperCase()

      span.admin-profile__copy
        strong= currentAccount.fullName
        small= currentAccount.email

    form(action="/admin/auth/logout" method="POST")
      button.button.button--secondary(type="submit") Đăng xuất