- const currentNav = typeof activePage !== "undefined" ? activePage : "";

mixin adminNavItem(url, label, icon, key)
  a.sidebar-link(
    href=url
    class=currentNav === key ? "is-active" : ""
    aria-current=currentNav === key ? "page" : false
  )
    svg.icon(aria-hidden="true")
      use(href="#" + icon)
    |  #{label}
    if currentNav === key
      span.sidebar-link__pill Đang mở

aside#sidebar.sidebar(aria-label="Điều hướng quản trị")
  a.sidebar-brand(
    href="/"
    aria-label="THPT Practice trang chủ"
  )
    span.sidebar-brand__mark
      svg.icon(aria-hidden="true")
        use(href="#i-cap")
    span
      b
        span THPT
        |  Practice
      small ADMIN PANEL

  .sidebar-section-label TỔNG QUAN

  nav.sidebar-nav(aria-label="Các trang quản trị")
    +adminNavItem("/admin/dashboard", "Tổng quan", "i-grid", "dashboard")

    .sidebar-section-label.sidebar-section-label--nested QUẢN LÝ 

    +adminNavItem("/admin/subjects", "Môn học", "i-book", "subjects")
    +adminNavItem("/admin/topics", "Chuyên đề", "i-layers", "topics")
    +adminNavItem("/admin/questions", "Ngân hàng câu hỏi", "i-help", "questions")
    +adminNavItem("/admin/exams", "Quản lý đề thi", "i-clipboard", "exams") 
    +adminNavItem("/admin/latex", "Các mẫu công thức", "i-function", "latex")
    

    .sidebar-section-label.sidebar-section-label--nested HỆ THỐNG
    +adminNavItem("/admin/users", "Quản lý người dùng", "i-users", "users")
    a.sidebar-website(href="/")
      svg.icon(aria-hidden="true")
        use(href="#i-external")
      |  Xem trang học sinh