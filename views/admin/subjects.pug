extends layouts/default.pug

block content
  .page-heading
    div
      .eyebrow
        svg.icon
          use(href="#i-book")
        |  DANH MỤC HỆ THỐNG
      h1 Quản lý môn học
      p Tạo và quản lý các môn học để xây dựng chuyên đề, ngân hàng câu hỏi và đề thi.

    button#newSubjectButton.button.button--primary.page-heading__action(
      type="button"
    )
      svg.icon
        use(href="#i-plus")
      |  Tạo môn học

  section.stats-grid(aria-label="Thống kê môn học")
    .stat-card
      span.stat-card__icon.stat-card__icon--blue
        svg.icon
          use(href="#i-book")
      div
        span.stat-card__label Tổng môn học
        strong#statTotal= totalSubjects
        span.stat-card__note Môn học trong hệ thống

    .stat-card
      span.stat-card__icon.stat-card__icon--green
        svg.icon
          use(href="#i-check")
      div
        span.stat-card__label Đang hoạt động
        strong#statActive= activeSubjects
        span.stat-card__note Cho phép sử dụng

    .stat-card
      span.stat-card__icon.stat-card__icon--violet
        svg.icon
          use(href="#i-layers")
      div
        span.stat-card__label Tổng chuyên đề
        strong#statTopics= totalTopics
        span.stat-card__note Chuyên đề trong hệ thống

  .content-grid
    section.panel.subjects-panel(aria-labelledby="subjectListTitle")
      .panel-header
        div
          h2#subjectListTitle
            | Danh sách môn học 
            span#subjectCount.count-chip= totalItems
          p Tra cứu và cập nhật thông tin các môn học.

      form.list-toolbar(action="/admin/subjects" method="GET" data-filter-form)
        label.search-input
          svg.icon
            use(href="#i-search")
          span.sr-only Tìm kiếm môn học
          input#searchInput(
            name="keyword"
            type="search"
            placeholder="Tìm theo tên hoặc mã môn..."
            value=keyword
            autocomplete="off"
          )

        label.filter-input
          svg.icon
            use(href="#i-filter")
          span.sr-only Lọc theo trạng thái
          select#statusFilter(name="status")
            option(value="all" selected=status === "all") Tất cả trạng thái
            option(value="active" selected=status === "active") Đang hoạt động
            option(value="inactive" selected=status === "inactive") Đã ẩn

        button.button.button--primary(type="submit") Tìm kiếm
        a.button.button--secondary(href="/admin/subjects") Đặt lại

      .table-scroll
        table.subject-table
          thead
            tr
              th MÔN HỌC
              th CHUYÊN ĐỀ
              th TRẠNG THÁI
              th.subject-table__actions-heading THAO TÁC

          tbody#subjectRows
            each subject in subjects
              tr
                td
                  .subject-identity
                    span.subject-bubble(data-color="blue")
                      svg.icon
                        use(href="#i-book")
                    span
                      strong= subject.name
                      small= subject.code

                td
                  span.topic-count
                    svg.icon
                      use(href="#i-layers")
                    |  #{subject.topicCount} chuyên đề

                td
                  span.status-tag(
                    class=subject.active ? "status-tag--active" : "status-tag--inactive"
                  )= subject.active ? "Hoạt động" : "Đã ẩn"

                td 
                  .subject-actions
                    button.table-action.table-action--edit(
                      type="button"
                      data-action="edit"
                      data-id=subject._id
                      data-name=subject.name
                      data-code=subject.code
                      data-description=subject.description
                      data-active=String(subject.active)
                      aria-label="Sửa môn " + subject.name
                      title="Chỉnh sửa"
                    )
                      svg.icon
                        use(href="#i-edit")

                    button.table-action.table-action--delete(
                      type="button"
                      data-action="delete"
                      data-id=subject._id
                      aria-label="Xóa môn " + subject.name
                      title="Xóa môn học"
                    )
                      svg.icon
                        use(href="#i-trash")

      #emptyState.empty-state(hidden=totalItems > 0)
        svg.icon
          use(href="#i-search")
        strong Không tìm thấy môn học
        p Thử đổi từ khóa tìm kiếm hoặc bộ lọc.

      .table-footer
        span#paginationSummary
          | Hiển thị #{startItem}–#{endItem} / #{totalItems} môn học

        if totalPages > 1
          nav#pagination.pagination(aria-label="Phân trang môn học")
            if currentPage > 1
              a.page-button(
                href=pageUrl(currentPage - 1)
                aria-label="Trang trước"
              )
                svg.icon
                  use(href="#i-left")
            else
              button.page-button(
                type="button"
                disabled
                aria-label="Trang trước"
              )
                svg.icon
                  use(href="#i-left")

            - const firstPage = Math.max(1, currentPage - 2);
            - const lastPage = Math.min(totalPages, currentPage + 2);

            if firstPage > 1
              a.page-button(href=pageUrl(1)) 1
              if firstPage > 2
                span(aria-hidden="true") …

            - for (let page = firstPage; page <= lastPage; page++)
              a.page-button(
                href=pageUrl(page)
                class=page === currentPage ? "is-active" : ""
                aria-current=page === currentPage ? "page" : false
                aria-label="Trang " + page
              )= page

            if lastPage < totalPages
              if lastPage < totalPages - 1
                span(aria-hidden="true") …
              a.page-button(href=pageUrl(totalPages))= totalPages

            if currentPage < totalPages
              a.page-button(
                href=pageUrl(currentPage + 1)
                aria-label="Trang tiếp"
              )
                svg.icon
                  use(href="#i-chevron")
            else
              button.page-button(
                type="button"
                disabled
                aria-label="Trang tiếp"
              )
                svg.icon
                  use(href="#i-chevron")

    section#formPanel.panel.form-panel(aria-labelledby="formTitle")
      .panel-header.panel-header--form
        div
          .form-panel__eyebrow THÔNG TIN MÔN HỌC
          h2#formTitle Tạo môn học mới
          p#formSubtitle Nhập thông tin để thêm môn học vào hệ thống.
        span.form-header-icon
          svg.icon
            use(href="#i-plus")

      form#subjectForm(novalidate)
        .field
          label(for="subjectName")
            | Tên môn học 
            em *
          input#subjectName(
            name="name"
            type="text"
            maxlength="80"
            placeholder="Ví dụ: Tiếng Anh"
            required
            autocomplete="off"
            aria-describedby="nameError"
          )
          small#nameError.field-error(aria-live="polite")

        .field
          label(for="subjectCode")
            | Mã môn học 
            em *
          input#subjectCode(
            name="code"
            type="text"
            maxlength="15"
            placeholder="Ví dụ: TIENGANH"
            required
            autocomplete="off"
            aria-describedby="codeHint codeError"
          )
          small#codeHint.field-hint
            | Viết hoa, không dấu, có thể dùng dấu gạch dưới.
          small#codeError.field-error(aria-live="polite")

        .field
          label(for="subjectDescription") Mô tả môn học
          textarea#subjectDescription(
            name="description"
            rows="3"
            maxlength="300"
            placeholder="Mô tả ngắn gọn về môn học..."
          )
          .char-count
            span#descriptionCount 0
            | /300 ký tự

        .field.status-field
          div
            label(for="subjectActive") Trạng thái hoạt động
            small Môn học có thể được chọn khi tạo chuyên đề.
          label.switch
            input#subjectActive(
              name="active"
              type="checkbox"
              checked
            )
            span.switch-track

        .form-preview
          span.form-preview__title XEM TRƯỚC
          .subject-identity
            span#previewBubble.subject-bubble(data-color="blue")
              svg.icon
                use(href="#i-book")
            div
              strong#previewName Tên môn học
              small#previewCode MAMON

        .form-actions
          button#resetButton.button.button--secondary(type="button")
            | Làm mới
          button#saveButton.button.button--primary(type="submit")
            svg.icon
              use(href="#i-plus")
            span#saveButtonText Thêm môn học

  #deleteModal.modal-overlay(hidden)
    section.dialog(
      role="alertdialog"
      aria-modal="true"
      aria-labelledby="deleteTitle"
      aria-describedby="deleteDescription"
    )
      .dialog__symbol
        svg.icon
          use(href="#i-trash")
      h2#deleteTitle Xóa môn học?
      p#deleteDescription
      .dialog__actions
        button#cancelDelete.button.button--secondary(type="button") Hủy
        button#confirmDelete.button.button--danger(type="button")
          | Xóa môn học

  #toast.toast(role="status" aria-live="polite")

block scripts
  script(src="/admin/js/subjects.js" defer)