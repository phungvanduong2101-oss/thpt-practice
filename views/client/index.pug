extends layouts/default.pug

block content
  section.hero(aria-labelledby="heroTitle")
    .hero-inner.container
      .hero-content
        span.hero-badge ÔN LUYỆN THI TỐT NGHIỆP THPT

        h1#heroTitle
          | Học chủ động
          br
          span Vững bước tương lai

        p.hero-description
          | Ngân hàng câu hỏi hệ thống, luyện tập theo chuyên đề,
          br.wide-only
          |  đề thi bám sát cấu trúc mới và cộng đồng học tập sôi nổi.

        form#searchForm.search-form(
          action="/exams"
          method="GET"
          role="search"
        )
          i(data-lucide="search" aria-hidden="true")

          label.sr-only(for="searchInput") Tìm kiếm đề thi

          input#searchInput(
            name="keyword"
            type="search"
            autocomplete="off"
            placeholder="Tìm kiếm đề thi..."
          )

          button.search-button(type="submit") Tìm kiếm