fieldset.hw-people
  legend Học sinh nhận bài
  .hw-people-actions
    button(type="button" data-select="all") Chọn tất cả
    button(type="button" data-select="none") Bỏ chọn
  .hw-people-list
    each p in people
      label
        input(type="checkbox" name="students" value=p._id checked=(typeof a !== 'undefined' && a.recipients.some(id=>String(id)===String(p._id))))
        |  #{p.fullName}
    else
      p.hw-help Nhóm chưa có học sinh để giao bài.
