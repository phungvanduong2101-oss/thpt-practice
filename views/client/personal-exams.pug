extends layouts/default.pug

block styles
  link(
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
  )
  link(rel="stylesheet" href="/client/css/group-exams.css")

block content
  include ../admin/partials/icons.pug

  .group-exam-page.container
    a.group-exams-back(href="/") ← Trang chủ
    #examPageData(
      hidden
      data-base-url="/my/exams"
      data-bootstrap=JSON.stringify({ subjects, exams })
    )

    .examadmin-main
      .page-heading.examadmin-heading
        div
          .eyebrow
            svg.icon
              use(href="#i-clipboard")
            |  QUẢN LÝ NỘI DUNG

          h1 Đề thi của tôi
          p Tạo đề theo môn học và chọn câu hỏi từ ngân hàng cá nhân.

        a.button.button--primary(href="/my/exams/create")
          svg.icon
            use(href="#i-plus")
          |  Tạo đề thi mới

      section.stats-grid.examadmin-stats(aria-label="Thống kê đề thi")
        .stat-card
          span.stat-card__icon.stat-card__icon--blue
            svg.icon
              use(href="#i-clipboard")
          div
            span.stat-card__label Tổng đề thi
            strong#statTotal= totalExams
            span.stat-card__note Trong hệ thống

        .stat-card
          span.stat-card__icon.stat-card__icon--green
            svg.icon
              use(href="#i-check")
          div
            span.stat-card__label Đã xuất bản
            strong#statPublished= publishedExams
            span.stat-card__note Học sinh có thể làm

        .stat-card
          span.stat-card__icon.stat-card__icon--violet
            svg.icon
              use(href="#i-help")
          div
            span.stat-card__label Câu hỏi đã chọn
            strong#statPicked= totalPicked
            span.stat-card__note Tổng lượt gắn vào đề

      .examadmin-layout.examadmin-layout--list
        section.panel.examadmin-list-panel(
          aria-labelledby="examListTitle"
        )
          .panel-header
            div
              h2#examListTitle
                | Danh sách đề thi 
                span#examCount.examadmin-count= totalItems
              p Xem, chỉnh sửa và quản lý trạng thái các đề thi.

          form#examFilterForm.examadmin-toolbar(
            action="/my/exams"
            method="GET"
          )
            label.examadmin-search
              svg.icon
                use(href="#i-search")
              span.sr-only Tìm đề thi

              input#examSearch(
                name="keyword"
                type="search"
                value=keyword
                placeholder="Tìm theo tên hoặc mô tả đề thi..."
                autocomplete="off"
              )

            .examadmin-toolbar-filters
              label
                span.sr-only Lọc môn học

                select#examSubjectFilter(name="subjectId")
                  option(
                    value="all"
                    selected=subjectId === "all"
                  ) Tất cả môn học

                  each subject in subjects
                    option(
                      value=subject._id
                      selected=String(subject._id) === subjectId
                    )= subject.name

              label
                span.sr-only Lọc trạng thái

                select#examStatusFilter(name="status")
                  option(
                    value="all"
                    selected=status === "all"
                  ) Mọi trạng thái

                  option(
                    value="published"
                    selected=status === "published"
                  ) Đã xuất bản

                  option(
                    value="draft"
                    selected=status === "draft"
                  ) Bản nháp

            .exam-preview-actions
              button.button.button--primary(type="submit")
                svg.icon
                  use(href="#i-search")
                |  Tìm kiếm

              a.button.button--secondary(href="/my/exams")
                | Đặt lại

          #examList.examadmin-list(aria-live="polite")

          #examEmpty.examadmin-empty(hidden=totalItems > 0)
            svg.icon
              use(href="#i-search")
            strong Chưa tìm thấy đề thi
            p Hãy thử bộ lọc khác hoặc tạo đề thi đầu tiên.

          .table-footer.examadmin-table-footer
            span#examPaginationSummary
              | Hiển thị #{startItem}–#{endItem} / #{totalItems} đề thi
              |  · Trang #{currentPage}/#{totalPages}

            if totalPages > 1
              nav#examPagination.pagination(
                aria-label="Phân trang đề thi"
              )
                if currentPage > 1
                  a.page-button(
                    href=pageUrl(currentPage - 1)
                    aria-label="Trang trước"
                  )
                    svg.icon
                      use(href="#i-left")

                each pageNumber in Array.from({ length: totalPages }, (_, index) => index + 1)
                  if pageNumber === 1 || pageNumber === totalPages || Math.abs(pageNumber - currentPage) <= 2
                    a.page-button(
                      href=pageUrl(pageNumber)
                      class=pageNumber === currentPage ? "is-active" : ""
                      aria-current=pageNumber === currentPage ? "page" : false
                      aria-label="Trang " + pageNumber
                    )= pageNumber
                  else if pageNumber === currentPage - 3 || pageNumber === currentPage + 3
                    span(aria-hidden="true") …

                if currentPage < totalPages
                  a.page-button(
                    href=pageUrl(currentPage + 1)
                    aria-label="Trang tiếp"
                  )
                    svg.icon
                      use(href="#i-chevron")

    #deleteModal.examadmin-modal-overlay(hidden)
      section.dialog(
        role="alertdialog"
        aria-modal="true"
        aria-labelledby="deleteTitle"
        aria-describedby="deleteMessage"
      )
        .dialog__symbol
          svg.icon
            use(href="#i-trash")

        h2#deleteTitle Xóa đề thi?
        p#deleteMessage Bạn có chắc chắn muốn xóa đề thi này?

        .dialog__actions
          button#cancelDeleteButton.button.button--secondary(
            type="button"
          )
            | Hủy

          button#confirmDeleteButton.button.button--danger(
            type="button"
          )
            | Xóa đề thi



block scripts
  script(src="/client/js/personal-exams-list.js" defer)
