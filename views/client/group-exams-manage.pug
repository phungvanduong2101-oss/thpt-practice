extends layouts/default.pug

block styles
  link(
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
  )
  link(
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css"
  )
  link(rel="stylesheet" href="/client/css/group-exams.css")

block content
  include ../admin/partials/icons.pug

  .group-exam-page.container
    a.group-exams-back(href="/groups/" + group._id) ← Chi tiết nhóm
    #examPageData(
      hidden
      data-base-url="/groups/" + group._id + "/exams"
      data-group-id=String(group._id)
      data-bootstrap=JSON.stringify({ subjects, topics, questions, exams })
    )

    .examadmin-main
      .page-heading.examadmin-heading
        div
          .eyebrow
            svg.icon
              use(href="#i-clipboard")
            |  QUẢN LÝ NỘI DUNG

          h1= "Đề thi · " + group.name
          p Tạo đề theo môn học và chọn câu hỏi riêng của nhóm.

        button#newExamButton.button.button--primary(type="button")
          svg.icon
            use(href="#i-plus")
          |  Tạo đề thi mới

      section.stats-grid.examadmin-stats(aria-label="Thống kê đề thi")
        .stat-card
          span.stat-card__icon.stat-card__icon--blue
            svg.icon
              use(href="#i-clipboard")
          div
            span.stat-card__label Tổng đề thi
            strong#statTotal= totalExams
            span.stat-card__note Trong hệ thống

        .stat-card
          span.stat-card__icon.stat-card__icon--green
            svg.icon
              use(href="#i-check")
          div
            span.stat-card__label Đã xuất bản
            strong#statPublished= publishedExams
            span.stat-card__note Học sinh có thể làm

        .stat-card
          span.stat-card__icon.stat-card__icon--violet
            svg.icon
              use(href="#i-help")
          div
            span.stat-card__label Câu hỏi đã chọn
            strong#statPicked= totalPicked
            span.stat-card__note Tổng lượt gắn vào đề

      .examadmin-layout
        section.panel.examadmin-list-panel(
          aria-labelledby="examListTitle"
        )
          .panel-header
            div
              h2#examListTitle
                | Danh sách đề thi 
                span#examCount.examadmin-count= totalItems
              p Xem, chỉnh sửa và quản lý trạng thái các đề thi.

          form#examFilterForm.examadmin-toolbar(
            action="/groups/" + group._id + "/exams/manage"
            method="GET"
          )
            label.examadmin-search
              svg.icon
                use(href="#i-search")
              span.sr-only Tìm đề thi

              input#examSearch(
                name="keyword"
                type="search"
                value=keyword
                placeholder="Tìm theo tên hoặc mô tả đề thi..."
                autocomplete="off"
              )

            .examadmin-toolbar-filters
              label
                span.sr-only Lọc môn học

                select#examSubjectFilter(name="subjectId")
                  option(
                    value="all"
                    selected=subjectId === "all"
                  ) Tất cả môn học

                  each subject in subjects
                    option(
                      value=subject._id
                      selected=String(subject._id) === subjectId
                    )= subject.name

              label
                span.sr-only Lọc trạng thái

                select#examStatusFilter(name="status")
                  option(
                    value="all"
                    selected=status === "all"
                  ) Mọi trạng thái

                  option(
                    value="published"
                    selected=status === "published"
                  ) Đã xuất bản

                  option(
                    value="draft"
                    selected=status === "draft"
                  ) Bản nháp

            .exam-preview-actions
              button.button.button--primary(type="submit")
                svg.icon
                  use(href="#i-search")
                |  Tìm kiếm

              a.button.button--secondary(href="/groups/" + group._id + "/exams/manage")
                | Đặt lại

          #examList.examadmin-list(aria-live="polite")

          #examEmpty.examadmin-empty(hidden=totalItems > 0)
            svg.icon
              use(href="#i-search")
            strong Chưa tìm thấy đề thi
            p Hãy thử bộ lọc khác hoặc tạo đề thi đầu tiên.

          .table-footer.examadmin-table-footer
            span#examPaginationSummary
              | Hiển thị #{startItem}–#{endItem} / #{totalItems} đề thi
              |  · Trang #{currentPage}/#{totalPages}

            if totalPages > 1
              nav#examPagination.pagination(
                aria-label="Phân trang đề thi"
              )
                if currentPage > 1
                  a.page-button(
                    href=pageUrl(currentPage - 1)
                    aria-label="Trang trước"
                  )
                    svg.icon
                      use(href="#i-left")

                each pageNumber in Array.from({ length: totalPages }, (_, index) => index + 1)
                  if pageNumber === 1 || pageNumber === totalPages || Math.abs(pageNumber - currentPage) <= 2
                    a.page-button(
                      href=pageUrl(pageNumber)
                      class=pageNumber === currentPage ? "is-active" : ""
                      aria-current=pageNumber === currentPage ? "page" : false
                      aria-label="Trang " + pageNumber
                    )= pageNumber
                  else if pageNumber === currentPage - 3 || pageNumber === currentPage + 3
                    span(aria-hidden="true") …

                if currentPage < totalPages
                  a.page-button(
                    href=pageUrl(currentPage + 1)
                    aria-label="Trang tiếp"
                  )
                    svg.icon
                      use(href="#i-chevron")

        section#examEditorPanel.panel.examadmin-editor-panel(
          aria-labelledby="examFormTitle"
        )
          .panel-header.examadmin-form-heading
            div
              .form-panel__eyebrow BIÊN TẬP ĐỀ THI
              h2#examFormTitle Tạo đề thi mới
              p Mỗi đề chỉ thuộc một môn học. Chọn câu hỏi đã xuất bản từ ngân hàng.

            span.form-header-icon
              svg.icon
                use(href="#i-edit")

          form#examForm(novalidate)
            .examadmin-step
              span 01
              |  Thông tin đề thi

            .field
              label(for="examTitle")
                | Tên đề thi 
                em *

              input#examTitle(
                name="title"
                type="text"
                maxlength="120"
                required
                placeholder="Ví dụ: Đề thi thử Tiếng Anh số 1"
              )

            .examadmin-fields-two
              .field
                label(for="examSubject")
                  | Môn học 
                  em *

                select#examSubject(name="subjectId" required)
                  option(value="") Chọn môn học

              .field
                label(for="examDuration")
                  | Thời gian (phút) 
                  em *

                input#examDuration(
                  name="duration"
                  type="number"
                  min="1"
                  max="300"
                  step="1"
                  value="60"
                  required
                )

            .field
              label(for="examDescription") Mô tả ngắn

              textarea#examDescription(
                name="description"
                rows="2"
                maxlength="500"
                placeholder="Mô tả nội dung và mục tiêu đề thi..."
              )

            .field
              label(for="examStatus") Trạng thái

              select#examStatus(name="status")
                option(value="draft") Bản nháp – Chưa hiển thị cho học sinh
                option(value="published") Đã xuất bản – Công khai

            .examadmin-step.examadmin-step--second
              span 02
              |  Câu hỏi trong đề

            .examadmin-picker-bar
              div
                b#pickedCount 0 câu hỏi
                small#pickedScore Chưa chọn câu hỏi

              button#openPickerButton.button.button--secondary.examadmin-add-btn(
                type="button"
              )
                svg.icon
                  use(href="#i-plus")
                |  Chọn câu hỏi

            #pickedList.examadmin-picked-list

            #pickedEmpty.examadmin-picked-empty
              | Chưa có câu hỏi nào. Hãy chọn môn học rồi nhấn 
              strong Chọn câu hỏi
              | .

            p.examadmin-note
              svg.icon
                use(href="#i-info")
              |  Một câu hỏi có thể dùng trong nhiều đề thi. Sửa thứ tự bằng mũi tên lên/xuống.

            p#examFormError.examadmin-error(
              role="alert"
              hidden
            )

            .examadmin-form-actions
              button#resetExamButton.button.button--secondary(
                type="button"
              )
                | Làm mới

              button#saveExamButton.button.button--primary(
                type="submit"
              )
                svg.icon
                  use(href="#i-save")
                span#saveExamText Lưu đề thi

    //- Modal chọn câu hỏi
    #pickerModal.examadmin-modal-overlay(hidden)
      section.examadmin-picker-modal(
        role="dialog"
        aria-modal="true"
        aria-labelledby="pickerTitle"
      )
        .examadmin-modal-header
          div
            span NGÂN HÀNG CÂU HỎI
            h2#pickerTitle Chọn câu hỏi vào đề thi
            p#pickerSubjectInfo
              | Chỉ hiển thị câu hỏi đã xuất bản đúng môn học

          button#closePickerButton.examadmin-icon-button(
            type="button"
            aria-label="Đóng"
          )
            svg.icon
              use(href="#i-x")

        .examadmin-picker-filters
          label.examadmin-search
            svg.icon
              use(href="#i-search")
            span.sr-only Tìm câu hỏi

            input#pickerSearch(
              type="search"
              placeholder="Tìm nội dung câu hỏi..."
            )

          label
            span.sr-only Nguồn câu hỏi
            select#pickerSource
              option(value="all") Tất cả nguồn
              option(value="system") Câu hỏi hệ thống
              option(value="group") Câu hỏi của nhóm

          label
            span.sr-only Chuyên đề
            select#pickerTopic
              option(value="all") Tất cả chuyên đề

          label
            span.sr-only Loại câu
            select#pickerType
              option(value="all") Mọi dạng câu
              option(value="mcq") Trắc nghiệm ABCD
              option(value="truefalse") Đúng / Sai
              option(value="fill") Điền đáp số

          label
            span.sr-only Mức Bloom
            select#pickerBloom
              option(value="all") Mọi mức Bloom
              option(value="1") 1 · Nhớ
              option(value="2") 2 · Hiểu
              option(value="3") 3 · Vận dụng
              option(value="4") 4 · Phân tích
              option(value="5") 5 · Đánh giá
              option(value="6") 6 · Sáng tạo

        #pickerResults.examadmin-picker-content(
          aria-live="polite"
        )

        .examadmin-picker-bottom
          span#pickerSummary 0 câu hỏi

          .examadmin-picker-footer-right
            nav#pickerPagination.pagination(
              aria-label="Phân trang câu hỏi"
            )

            button#donePickerButton.button.button--primary(
              type="button"
            )
              | Xong (
              span#pickerSelectedCount 0
              | )

    //- Modal xem trước câu hỏi
    #examQuestionPreviewModal.examadmin-modal-overlay.question-modal(hidden)
      section.dialog.question-dialog(
        role="dialog"
        aria-modal="true"
        aria-labelledby="examQuestionPreviewTitle"
      )
        .question-modal-heading
          div
            span XEM TRƯỚC CÂU HỎI VÀ ĐÁP ÁN
            h2#examQuestionPreviewTitle Nội dung câu hỏi

          button#closeExamQuestionPreview.question-icon-button(
            type="button"
            aria-label="Đóng xem trước"
          )
            svg.icon
              use(href="#i-x")

        #examQuestionPreviewBody.preview-body

        .dialog__actions
          button#doneExamQuestionPreview.button.button--primary(
            type="button"
          )
            | Đóng xem trước

    //- Modal xác nhận xóa đề thi
    #deleteModal.examadmin-modal-overlay(hidden)
      section.dialog(
        role="alertdialog"
        aria-modal="true"
        aria-labelledby="deleteTitle"
        aria-describedby="deleteMessage"
      )
        .dialog__symbol
          svg.icon
            use(href="#i-trash")

        h2#deleteTitle Xóa đề thi?
        p#deleteMessage Bạn có chắc chắn muốn xóa đề thi này?

        .dialog__actions
          button#cancelDeleteButton.button.button--secondary(
            type="button"
          )
            | Hủy

          button#confirmDeleteButton.button.button--danger(
            type="button"
          )
            | Xóa đề thi



block scripts
  script(
    defer
    src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"
  )
  script(src="/client/js/group-exams.js" defer)