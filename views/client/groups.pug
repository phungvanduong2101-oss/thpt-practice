extends layouts/default.pug

block styles
  link(rel="stylesheet" href="/client/css/groups.css")
  link(rel="stylesheet" href="/client/css/groups-extra.css")
  link(rel="stylesheet" href="/client/css/group-browse.css")

block content
  -
    const makePageUrl = page => {
      const params = new URLSearchParams({
        keyword,
        status,
        acceptingMembers,
        page: String(page),
      });

      return "/groups?" + params.toString();
    };

    const firstPage = Math.max(1, currentPage - 2);
    const lastPage = Math.min(totalPages, currentPage + 2);

  section.group-page-hero(aria-labelledby="groupPageTitle")
    .container.group-page-hero__inner
      span.group-page-hero__badge NHÓM HỌC TẬP

      h1#groupPageTitle.group-page-hero__title
        | Khám phá nhóm học tập

      p.group-page-hero__desc
        | Tìm kiếm và tham gia các nhóm học tập phù hợp để cùng
        |  ôn luyện, trao đổi tài liệu và hỗ trợ nhau tiến bộ mỗi ngày.

  section.group-filter-section(
    aria-label="Tìm kiếm và lọc nhóm học tập"
  )
    form.container.group-filter-bar(
      action="/groups"
      method="GET"
    )
      .group-search-wrap
        i.group-search-icon(
          data-lucide="search"
          aria-hidden="true"
        )

        label.sr-only(for="groupSearchInput")
          | Tìm kiếm theo tên nhóm

        input#groupSearchInput.group-search-input(
          type="search"
          name="keyword"
          value=keyword
          placeholder="Tìm kiếm theo tên nhóm..."
          autocomplete="off"
        )

      .group-filter-selects
        .group-select-wrap
          i.group-select-icon(
            data-lucide="activity"
            aria-hidden="true"
          )

          label.sr-only(for="filterGroupStatus")
            | Trạng thái hoạt động

          select#filterGroupStatus.group-select(name="status")
            option(
              value=""
              selected=status === ""
            ) Tất cả trạng thái

            option(
              value="active"
              selected=status === "active"
            ) Đang hoạt động

            option(
              value="inactive"
              selected=status === "inactive"
            ) Ngừng hoạt động

          i.group-select-chevron(
            data-lucide="chevron-down"
            aria-hidden="true"
          )

        .group-select-wrap
          i.group-select-icon(
            data-lucide="user-plus"
            aria-hidden="true"
          )

          label.sr-only(for="filterAcceptingMembers")
            | Trạng thái nhận thành viên

          select#filterAcceptingMembers.group-select(
            name="acceptingMembers"
          )
            option(
              value=""
              selected=acceptingMembers === ""
            ) Nhận thành viên: Tất cả

            option(
              value="true"
              selected=acceptingMembers === "true"
            ) Đang nhận thành viên

            option(
              value="false"
              selected=acceptingMembers === "false"
            ) Đã đóng đăng ký

          i.group-select-chevron(
            data-lucide="chevron-down"
            aria-hidden="true"
          )

      .group-filter-actions
        button.group-filter-submit(type="submit")
          | Tìm kiếm

        a.group-filter-reset(href="/groups")
          | Đặt lại

  section.group-list-section(aria-label="Danh sách nhóm học tập")
    .container.group-list-inner
      .discover-results-heading
        h2 Nhóm học tập
        span #{totalItems} nhóm
      if groups.length
        .discover-grid
          each group in groups
            article.discover-card
              .discover-card-top
                span.discover-avatar(aria-hidden="true")
                  i(data-lucide="users")
                span.discover-status(class=group.status==='active'?'is-active':'')
                  = group.status==='active' ? (group.acceptingMembers?'Đang nhận thành viên':'Đã đóng đăng ký') : 'Ngừng hoạt động'
              h2
                a(href="/groups/"+group._id)= group.name
              p.discover-description= group.description || "Nhóm chưa có mô tả."
              .discover-meta
                span
                  i(data-lucide="user-round" aria-hidden="true")
                  = group.ownerId ? group.ownerId.fullName : "Tài khoản không còn tồn tại"
                span
                  i(data-lucide="users-round" aria-hidden="true")
                  | #{(group.memberIds || []).length} thành viên
              a.discover-open(href="/groups/"+group._id)
                | Xem nhóm
                i(data-lucide="arrow-right" aria-hidden="true")
      else
        .group-empty
          i.group-empty__icon(data-lucide="users-round" aria-hidden="true")
          p.group-empty__title Không tìm thấy nhóm học tập
          p.group-empty__desc Thử thay đổi từ khóa hoặc bộ lọc để tìm nhóm phù hợp.

      if totalItems > 0
        p.group-list-summary
          | Hiển thị #{startItem}–#{endItem} trong #{totalItems} nhóm

      if totalPages > 1
        nav.group-pagination(aria-label="Phân trang danh sách nhóm")
          if currentPage > 1
            a.group-page-link(href=makePageUrl(1))
              | Đầu

            a.group-page-link(href=makePageUrl(currentPage - 1))
              | Trước

          - let pageNumber = firstPage;

          while pageNumber <= lastPage
            if pageNumber === currentPage
              span.group-page-link.is-active(aria-current="page")
                = pageNumber
            else
              a.group-page-link(href=makePageUrl(pageNumber))
                = pageNumber

            - pageNumber++;

          if currentPage < totalPages
            a.group-page-link(href=makePageUrl(currentPage + 1))
              | Sau

            a.group-page-link(href=makePageUrl(totalPages))
              | Cuối