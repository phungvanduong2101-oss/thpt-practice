extends layouts/default.pug

block styles
  link(rel="stylesheet" href="/client/css/exams.css")

  style.
    .exam-filter-bar {
      flex-wrap: wrap;
    }

    .exam-filter-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .exam-filter-submit,
    .exam-filter-reset {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 10px 18px;
      border: 0;
      border-radius: 10px;
      font: inherit;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
    }

    .exam-filter-submit {
      background: #0866ff;
      color: #fff;
    }

    .exam-filter-reset {
      background: #edf4ff;
      color: #0866ff;
    }

    .client-exam-card {
      display: flex;
      flex-direction: column;
      gap: 16px;
      padding: 24px;
      border: 1px solid #e5eaf3;
      border-radius: 18px;
      background: #fff;
      box-shadow: 0 6px 24px rgba(15, 23, 42, .04);
    }

    .client-exam-card__subject {
      align-self: flex-start;
      padding: 6px 12px;
      border-radius: 8px;
      background: #edf4ff;
      color: #0866ff;
      font-size: 13px;
      font-weight: 600;
    }

    .client-exam-card__title {
      margin: 0;
      color: #0f172a;
      font-size: 19px;
      line-height: 1.5;
      overflow-wrap: anywhere;
    }

    .client-exam-card__description {
      margin: 0;
      color: #64748b;
      font-size: 14px;
      line-height: 1.7;
      overflow-wrap: anywhere;
    }

    .client-exam-card__meta {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      margin-top: auto;
      color: #64748b;
      font-size: 14px;
    }

    .client-exam-card__start {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 12px 18px;
      border-radius: 10px;
      background: #0866ff;
      color: #fff;
      font-weight: 600;
      text-decoration: none;
    }

    .client-exam-card__start:hover {
      background: #0058ed;
    }

    .client-exam-summary {
      margin-bottom: 20px;
      color: #64748b;
      font-size: 14px;
    }

    .exam-pagination a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 40px;
      min-height: 40px;
      padding: 8px 12px;
      border: 1px solid #e5eaf3;
      border-radius: 10px;
      background: #fff;
      color: #334155;
      text-decoration: none;
    }

    .exam-pagination a.is-active {
      border-color: #0866ff;
      background: #0866ff;
      color: #fff;
    }

    .exam-pagination a:hover {
      border-color: #0866ff;
    }

block content
  section.exam-page-hero(aria-labelledby="examPageTitle")
    .container.exam-page-hero__inner
      span.exam-page-hero__badge ĐỀ THI THPT

      h1#examPageTitle.exam-page-hero__title Danh sách đề thi

      p.exam-page-hero__desc
        | Khám phá các đề thi theo môn học, luyện tập và củng cố kiến thức.

  section.exam-filter-section(aria-label="Tìm kiếm và lọc đề thi")
    form#clientExamFilterForm.container.exam-filter-bar(
      action="/exams"
      method="GET"
    )
      .exam-search-wrap
        i.exam-search-icon(
          data-lucide="search"
          aria-hidden="true"
        )

        label.sr-only(for="examSearchInput")
          | Tìm kiếm đề thi theo tên

        input#examSearchInput.exam-search-input(
          name="keyword"
          type="search"
          value=keyword
          placeholder="Tìm kiếm đề thi theo tên..."
          autocomplete="off"
        )

      .exam-filter-selects
        .exam-select-wrap
          i.exam-select-icon(
            data-lucide="book-open"
            aria-hidden="true"
          )

          label.sr-only(for="filterSubject") Lọc theo môn học

          select#filterSubject.exam-select(name="subjectId")
            option(
              value="all"
              selected=subjectId === "all"
            ) Tất cả môn học

            each subject in subjects
              option(
                value=subject._id
                selected=String(subject._id) === subjectId
              )= subject.name

          i.exam-select-chevron(
            data-lucide="chevron-down"
            aria-hidden="true"
          )

      .exam-filter-actions
        button.exam-filter-submit(type="submit") Tìm kiếm
        a.exam-filter-reset(href="/exams") Đặt lại

  section.exam-list-section(aria-label="Danh sách đề thi")
    .container
      p.client-exam-summary
        | Hiển thị #{startItem}–#{endItem} / #{totalItems} đề thi

      #examGrid.exam-grid(
        role="list"
        aria-live="polite"
        aria-atomic="false"
      )
        each exam in exams
          article.client-exam-card(role="listitem")
            span.client-exam-card__subject
              = exam.subjectId ? exam.subjectId.name : "Môn học không còn tồn tại"

            h2.client-exam-card__title= exam.title

            if exam.description
              p.client-exam-card__description= exam.description

            .client-exam-card__meta
              span #{exam.questionCount} câu hỏi
              span #{exam.duration} phút

            a.client-exam-card__start(
              href="/exams/" + exam._id
            ) Làm ngay

      #examEmpty.exam-empty(hidden=totalItems > 0)
        i.exam-empty__icon(
          data-lucide="file-text"
          aria-hidden="true"
        )

        p.exam-empty__title Không tìm thấy đề thi

        p.exam-empty__desc
          | Thử thay đổi từ khóa hoặc bộ lọc để tìm đề thi phù hợp.

      if totalPages > 1
        nav#examPagination.exam-pagination(
          aria-label="Phân trang danh sách đề thi"
        )
          if currentPage > 1
            a(
              href=pageUrl(currentPage - 1)
              aria-label="Trang trước"
            ) Trước

          each pageNumber in Array.from({ length: totalPages }, (_, index) => index + 1)
            if pageNumber === 1 || pageNumber === totalPages || Math.abs(pageNumber - currentPage) <= 2
              a(
                href=pageUrl(pageNumber)
                class=pageNumber === currentPage ? "is-active" : ""
                aria-current=pageNumber === currentPage ? "page" : false
                aria-label="Trang " + pageNumber
              )= pageNumber
            else if pageNumber === currentPage - 3 || pageNumber === currentPage + 3
              span(aria-hidden="true") …

          if currentPage < totalPages
            a(
              href=pageUrl(currentPage + 1)
              aria-label="Trang tiếp"
            ) Tiếp

block scripts
  script.
    document.getElementById('filterSubject')
      ?.addEventListener('change', () => {
        document.getElementById('clientExamFilterForm').requestSubmit();
      });