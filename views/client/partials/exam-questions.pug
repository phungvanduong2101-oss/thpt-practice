each question, index in questions
  - const qid = String(question._id || question.questionId);

  - const editable = typeof homeworkDraft !== "undefined";
  - const saved = editable ? homeworkDraft[qid] : null;
  article.et-question-card(
    id="question-" + qid
    data-id=qid
    data-qid=qid
    data-type=question.type
  )
    .et-q-header
      .et-q-header-left
        span.et-q-num-badge Câu #{index + 1}
        span.et-type-badge= typeNames[question.type]

      if !editable
        button.et-q-flag-btn(
          type="button"
          aria-label="Đánh dấu câu " + (index + 1)
          aria-pressed="false"
          disabled=!editable
        )
          | ⚑ Đánh dấu
  
    .et-q-content
      .et-rich.ql-editor
        if question.content && question.content.html
          != question.content.html
        else
          p= question.contentText || ""

    if question.type === "mcq"
      .et-options-grid(
        role="group"
        aria-label="Đáp án câu " + (index + 1)
      )
        each option in question.options
          label.et-option-label(class=!editable && "et-option-label--disabled")
            input.et-radio(
              type="radio"
              name="answer-" + qid
              checked=editable && saved===option.key
              value=option.key
              disabled=!editable
            )
            span.et-radio-circle(aria-hidden="true")
            .et-answer-copy
              strong.et-option-key #{option.key}.
              .et-rich.ql-editor
                != option.content ? option.content.html : ""

    else if question.type === "truefalse"
      .et-tf-list
        each option in question.options
          fieldset.et-tf-row(data-option-key=option.key)
            legend.et-tf-legend Mệnh đề #{option.key}

            .et-tf-content
              strong.et-option-key #{option.key}.
              .et-rich.ql-editor
                != option.content ? option.content.html : ""

            .et-options-grid.et-options-tf(role="group" aria-label="Đáp án mệnh đề " + option.key)
              each labelText, answerValue in { true: "Đúng", false: "Sai" }
                label.et-option-label(class=!editable && "et-option-label--disabled")
                  input.et-radio(
                    type="radio"
                    name="answer-" + qid + "-" + option.key
                    checked=editable && saved && String(saved[option.key])===answerValue
                    data-key=option.key
                    value=answerValue
                    disabled=!editable
                  )
                  span.et-radio-circle(aria-hidden="true")
                  span= labelText

    else if question.type === "fill"
      label.et-fill-label(for="fill-" + qid) Đáp án của bạn

      input.et-fill-input(
        id="fill-" + qid
        type="text"
        value=editable ? saved : undefined
        maxlength="200"
        autocomplete="off"
        placeholder="Nhập đáp án..."
        disabled=!editable
      )

